[Unit]
Description=Yokaze button polling service

[Service]
Type=simple
ExecStart=%h/.local/bin/yokaze-button
Restart=on-failure
RestartSec=5

# Environment for desktop notifications and shared runtime paths
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=SANE_USB_WORKAROUND=1
# Scanner/Paperless: identity-scoped ~/.config/yokaze{,-dev}/scanner.conf
# (poller picks identity from which GUI is open; headless uses user)

[Install]
WantedBy=default.target
